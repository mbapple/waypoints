# WayPoints configuration
# Copy to .env (which is gitignored) and fill in values:
#   cp .env.example .env
# docker compose reads .env automatically and passes each value only to the
# service that needs it (see docker-compose.yml.example).

# --- Database -------------------------------------------------------------
# Used by the postgis container on FIRST start to create the database, and by
# the backend to connect.
# UPGRADING an existing install: an existing ./db_data keeps the user/password
# it was created with (the old defaults were user / password). Set these to
# match, since changing them here does NOT change an existing database.
POSTGRES_USER=waypoints
POSTGRES_PASSWORD=change_me
POSTGRES_DB=travel_database

# --- Integrations -----------------------------------------------------------
# OpenRouteService key for auto-filling driving legs (distance, time, route).
# Free key: https://openrouteservice.org/dev/#/signup
# This stays on the backend and is never sent to the browser.
ORS_API_KEY=

# OpenSky Network API client, for fetching the actual flown path of a flight
# from its flight number and date. Free account: https://opensky-network.org
# then Account > API Client > create client. OpenSky publishes flights the day
# after they fly and keeps tracks for about 30 days, so fetch the path within
# that window; older flights are drawn as a great-circle arc. Server-side only.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Immich photo library, for linking trip photos from Immich.
# IMMICH_URL is the address the BACKEND container uses to reach Immich, e.g.
# http://immich_server:2283 (same Docker network) or https://photos.example.com.
# Create an API key in Immich under Account Settings > API Keys. It needs at
# least the asset.read and asset.view permissions.
# All Immich requests go through the backend; the browser never sees the URL
# or key. Note that anyone who can reach WayPoints can then browse the photos
# this key can read, so keep WayPoints on a trusted network.
IMMICH_URL=
IMMICH_API_KEY=
# Optional: the Immich address your BROWSER uses, e.g. https://photos.example.com.
# The photo viewer's "Open in Immich" link redirects there (the key is not sent).
# Leave empty to use IMMICH_URL, which is fine when the browser can reach it too.
IMMICH_PUBLIC_URL=

# Nominatim, used by the backend to look up which city each node and stop is in
# (Cities map view). Defaults to the public server (about 1 request/second).
# NOMINATIM_LANGUAGE sets the language of city names, e.g. "en" -> "Vienna".
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_LANGUAGE=en

# --- Backend ----------------------------------------------------------------
# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
# Host port the web UI is published on.
FRONTEND_PORT=3000
# Hostnames the web UI may be reached by, comma-separated (e.g. a reverse-proxy
# domain like waypoints.example.com). localhost and IP addresses always work.
# Use "all" to disable the check.
FRONTEND_ALLOWED_HOSTS=
