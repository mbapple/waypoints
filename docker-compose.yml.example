# Copy to docker-compose.yml (gitignored) and adjust paths/ports as needed.
# Settings and secrets come from .env (copy .env.example); compose reads it
# automatically. Each service only receives the variables it needs.
services:
  db:
    image: postgis/postgis:17-3.5
    container_name: travel_database
    restart: always
    environment:
      POSTGRES_USER: ${POSTGRES_USER:?set POSTGRES_USER in .env}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      POSTGRES_DB: ${POSTGRES_DB:-travel_database}
    #ports:
    #  - "5432:5432"
    volumes:
      - ./db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10

  backend:
    build:
      context: ./src/backend
      dockerfile: Dockerfile
    container_name: waypoints_backend
    restart: always
    depends_on:
      db:
        condition: service_healthy
    environment:
      DB_HOST: db
      DB_PORT: "5432"
      DB_NAME: ${POSTGRES_DB:-travel_database}
      DB_USER: ${POSTGRES_USER:?set POSTGRES_USER in .env}
      DB_PASS: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      ALLOWED_ORIGINS: ${ALLOWED_ORIGINS:-http://localhost:3000}
      ORS_API_KEY: ${ORS_API_KEY:-}
      OPENSKY_CLIENT_ID: ${OPENSKY_CLIENT_ID:-}
      OPENSKY_CLIENT_SECRET: ${OPENSKY_CLIENT_SECRET:-}
      IMMICH_URL: ${IMMICH_URL:-}
      IMMICH_API_KEY: ${IMMICH_API_KEY:-}
      IMMICH_PUBLIC_URL: ${IMMICH_PUBLIC_URL:-}
      NOMINATIM_URL: ${NOMINATIM_URL:-https://nominatim.openstreetmap.org}
      NOMINATIM_LANGUAGE: ${NOMINATIM_LANGUAGE:-en}
    #ports:
    #  - "3001:3001"
    volumes:
      - ./src/backend:/workspaces/src/backend
      - ./uploads:/workspaces/src/uploads
      - ./backups:/workspaces/src/backups
    command: ["bash", "-lc", "chmod +x /workspaces/src/backend/app/start.sh && /workspaces/src/backend/app/start.sh"]

  frontend:
    image: node:24
    container_name: waypoints_frontend
    restart: always
    depends_on:
      - backend
    environment:
      CHOKIDAR_USEPOLLING: "true"
      BACKEND_URL: "http://waypoints_backend:3001"
      FRONTEND_ALLOWED_HOSTS: ${FRONTEND_ALLOWED_HOSTS:-}
    ports:
      - "${FRONTEND_PORT:-3000}:3000"
    volumes:
      - ./src/frontend:/app
    working_dir: /app
    command: ["bash", "-lc", "npm ci && npm start"]
